<UserControl x:Class="Blastic.Wpf.Sample.UserInterface.HomeView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:controlExtensions="clr-namespace:Blastic.ControlExtensions;assembly=Blastic.Wpf"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:execution="clr-namespace:Blastic.Execution;assembly=Blastic.Wpf"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:controlExtensions1="clr-namespace:Blastic.Wpf.ControlExtensions;assembly=Blastic.Wpf"
			 xmlns:execution1="clr-namespace:Blastic.Wpf.Execution;assembly=Blastic.Wpf"
			 mc:Ignorable="d"
			 d:DataContext="{d:DesignInstance local:HomeViewModel}">
	<Grid controlExtensions1:GridExtensions.RowDefinitions="Auto,*">
		<StackPanel Grid.Row="0">
			<Button Command="{Binding TestCommand}"
					Content="{Binding ButtonText.Value}" />

			<Button Command="{Binding HelpCommand}"
					Content="Help" />
		</StackPanel>

		<TextBox Grid.Row="1"
				 HorizontalAlignment="Center"
				 VerticalAlignment="Center"
				 Text="{Binding Text.Value, UpdateSourceTrigger=PropertyChanged}" />

		<execution1:ExecutionContextView Grid.Row="0"
										Grid.RowSpan="2"
										ExecutionContext="{Binding ExecutionContext}" />
	</Grid>
</UserControl>