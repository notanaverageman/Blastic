<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
		<TargetFramework>net9.0-windows</TargetFramework>
		<OutputType>WinExe</OutputType>
		<UseWPF>true</UseWPF>
		<StartupObject>Blastic.Wpf.Sample.Program</StartupObject>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="DynamicData" />
		<PackageReference Include="InputSimulatorStandard" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" />
		<PackageReference Include="Microsoft.Extensions.Hosting" />
		<PackageReference Include="SharpVectors" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Blastic.Wpf.Material\Blastic.Wpf.Material.csproj" />
		<ProjectReference Include="..\Blastic.Wpf\Blastic.Wpf.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Resource Include="Resources\*" />
	</ItemGroup>

	<ItemGroup>
		<None Update="AppSettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
</Project>