<UserControl x:Class="Blastic.Wpf.Controls.BusyIndicator"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:controlExtensions="clr-namespace:Blastic.ControlExtensions"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:controls="clr-namespace:Blastic.Wpf.Controls"
			 xmlns:controlExtensions1="clr-namespace:Blastic.Wpf.ControlExtensions"
			 mc:Ignorable="d">

	<controls:ChildWindow IsOpen="{Binding ExecutionContext.IsBusy.Value, RelativeSource={RelativeSource AncestorType=controls:BusyIndicator}}">

		<controls:ChildWindow.InputBindings>
			<KeyBinding Key="Escape"
						Command="{Binding Cancel, RelativeSource={RelativeSource AncestorType=controls:BusyIndicator}}" />
		</controls:ChildWindow.InputBindings>

		<Grid Margin="8,16,8,8"
			  controlExtensions1:GridExtensions.RowDefinitions="Auto,*,Auto,Auto">

			<TextBlock Grid.Row="0"
					   MinWidth="400"
					   MaxWidth="600"
					   HorizontalAlignment="Left"
					   VerticalAlignment="Center"
					   Text="{Binding ExecutionContext.ProgressMessage.Value, RelativeSource={RelativeSource AncestorType=controls:BusyIndicator}}" />

			<ScrollViewer Grid.Row="1"
						  MaxHeight="400"
						  Margin="8,8,0,0"
						  controlExtensions1:ScrollViewerExtensions.AutoScroll="True"
						  VerticalScrollBarVisibility="Auto">
				<ItemsControl ItemsSource="{Binding ExecutionContext.ProgressDetails, RelativeSource={RelativeSource AncestorType=controls:BusyIndicator}}" />
			</ScrollViewer>

			<ProgressBar Grid.Row="2"
						 Margin="0,24,0,8"
						 VerticalAlignment="Center"
						 IsIndeterminate="True" />

			<Button Grid.Row="3"
					HorizontalAlignment="Right"
					Command="{Binding Cancel, RelativeSource={RelativeSource AncestorType=controls:BusyIndicator}}"
					Content="Cancel"
					IsEnabled="{Binding ExecutionContext.IsCancellationSupported.Value, RelativeSource={RelativeSource AncestorType=controls:BusyIndicator}}" />
		</Grid>
	</controls:ChildWindow>
</UserControl>