<UserControl x:Class="Blastic.Wpf.Controls.Notifications.NotificationView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:controlExtensions="clr-namespace:Blastic.ControlExtensions"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:dynamicControls="clr-namespace:Blastic.DynamicControls"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:notifications="clr-namespace:Blastic.Services.Notifications;assembly=Blastic.Core"
			 xmlns:controlExtensions1="clr-namespace:Blastic.Wpf.ControlExtensions"
			 xmlns:dynamicControls1="clr-namespace:Blastic.Wpf.DynamicControls"
			 mc:Ignorable="d"
			 d:DataContext="{d:DesignInstance notifications:Notification}">

	<Border Padding="8"
			Background="White"
			BorderBrush="Black"
			BorderThickness="1">
		<Border.Effect>
			<DropShadowEffect />
		</Border.Effect>

		<Grid controlExtensions1:GridExtensions.RowDefinitions="Auto,*">
			<Button Grid.Row="0"
					HorizontalAlignment="Right"
					Command="{Binding Dismiss}"
					Content="×" />

			<dynamicControls1:DynamicControl Grid.Row="1"
											Model="{Binding Notification.Model, RelativeSource={RelativeSource AncestorType=local:NotificationView}}" />
		</Grid>
	</Border>
</UserControl>