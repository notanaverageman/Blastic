<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:controls="clr-namespace:Blastic.Wpf.Controls"
					xmlns:converters="clr-namespace:Blastic.Wpf.Converters"
					xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
					xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
					mc:Ignorable="d">

	<Style TargetType="{x:Type controls:DualView}">
		<Setter Property="VerticalContentAlignment" Value="Center" />

		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type controls:DualView}">
					<Grid>
						<Grid.Resources>
							<converters:InverseVisibilityConverter x:Key="InverseVisibilityConverter" />
							<BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
						</Grid.Resources>

						<ContentPresenter Name="First"
										  Content="{Binding FirstView, RelativeSource={RelativeSource AncestorType=controls:DualView}}"
										  Visibility="{Binding ShowFirstView, RelativeSource={RelativeSource AncestorType=controls:DualView}, Converter={StaticResource BooleanToVisibilityConverter}}" />

						<ContentPresenter Content="{Binding SecondView, RelativeSource={RelativeSource AncestorType=controls:DualView}}"
										  Visibility="{Binding Visibility, ElementName=First, Converter={StaticResource InverseVisibilityConverter}}" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>