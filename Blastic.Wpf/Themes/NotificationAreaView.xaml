<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:controls="clr-namespace:Blastic.Wpf.Controls"
					xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
					xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
					mc:Ignorable="d">

	<Style TargetType="{x:Type controls:NotificationAreaView}">
		<Setter Property="VerticalContentAlignment" Value="Center" />

		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type controls:NotificationAreaView}">
					<Grid Background="Transparent">
						<ItemsControl ItemsSource="{Binding NotificationService.ActiveNotifications, RelativeSource={RelativeSource AncestorType=controls:NotificationAreaView}}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<controls:NotificationView Margin="16"
															   Notification="{Binding}" />
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>