<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:controlExtensions="clr-namespace:Blastic.Wpf.ControlExtensions"
					xmlns:controls="clr-namespace:Blastic.Wpf.Controls"
					xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
					xmlns:dynamicControls="clr-namespace:Blastic.Wpf.DynamicControls"
					xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
					xmlns:notifications="clr-namespace:Blastic.Services.Notifications;assembly=Blastic"
					mc:Ignorable="d">

	<Style TargetType="{x:Type controls:NotificationView}">
		<Setter Property="VerticalContentAlignment" Value="Center" />

		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type controls:NotificationView}">
					<Border Padding="8"
							d:DataContext="{d:DesignInstance notifications:Notification}"
							Background="White"
							BorderBrush="Black"
							BorderThickness="1">
						<Border.Effect>
							<DropShadowEffect />
						</Border.Effect>

						<Grid controlExtensions:GridExtensions.RowDefinitions="Auto,*">
							<Button Grid.Row="0"
									HorizontalAlignment="Right"
									Command="{Binding Dismiss}"
									Content="×" />

							<dynamicControls:DynamicControl Grid.Row="1"
															Model="{Binding Notification.Model, RelativeSource={RelativeSource AncestorType=controls:NotificationView}}" />
						</Grid>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>