<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:controlExtensions="clr-namespace:Blastic.ControlExtensions"
					xmlns:converters="clr-namespace:Blastic.Converters"
					xmlns:group="clr-namespace:Blastic.DynamicControls.Presenters"
					xmlns:help="clr-namespace:Blastic.Controls.Help">

	<converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

	<Style TargetType="{x:Type group:GroupPresenter}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type group:GroupPresenter}">
					<Grid controlExtensions:GridExtensions.ColumnDefinitions="*,Auto">
						<Grid Name="PART_FieldsGrid"
							  Grid.Column="0" />

						<help:HelpView Grid.Column="1"
									   HelpContent="{Binding Help.Value, RelativeSource={RelativeSource AncestorType=group:GroupPresenter}}"
									   Visibility="{Binding Help.Value, RelativeSource={RelativeSource AncestorType=group:GroupPresenter}, Converter={StaticResource NullToVisibilityConverter}}" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>