<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:controlExtensions="clr-namespace:Blastic.ControlExtensions"
					xmlns:converters="clr-namespace:Blastic.Wpf.Converters"
					xmlns:text="clr-namespace:Blastic.Wpf.DynamicControls.Presenters"
					xmlns:controlExtensions1="clr-namespace:Blastic.Wpf.ControlExtensions"
					xmlns:help="clr-namespace:Blastic.Wpf.Controls.Help">

	<converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

	<Style TargetType="{x:Type text:TextPresenter}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type text:TextPresenter}">
					<Grid controlExtensions1:GridExtensions.ColumnDefinitions="Auto,*,Auto">
						<TextBox Name="PropertyControl"
								 Grid.Column="1"
								 Margin="0,-14,0,0"
								 VerticalAlignment="Center"
								 controlExtensions1:TextBoxMasking.Mask="{Binding Mask.Value, RelativeSource={RelativeSource AncestorType=text:TextPresenter}}"
								 IsEnabled="{Binding IsEnabledReactive.Value, RelativeSource={RelativeSource AncestorType=text:TextPresenter}}"
								 Text="{Binding Property.Value, RelativeSource={RelativeSource AncestorType=text:TextPresenter}, UpdateSourceTrigger=PropertyChanged}" />

						<help:HelpView Grid.Column="2"
									   HelpContent="{Binding Help.Value, RelativeSource={RelativeSource AncestorType=text:TextPresenter}}"
									   Visibility="{Binding Help.Value, RelativeSource={RelativeSource AncestorType=text:TextPresenter}, Converter={StaticResource NullToVisibilityConverter}}" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>