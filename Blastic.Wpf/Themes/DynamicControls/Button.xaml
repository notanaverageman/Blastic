<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:action="clr-namespace:Blastic.DynamicControls.Presenters"
					xmlns:converters="clr-namespace:Blastic.Converters">

	<converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

	<Style TargetType="{x:Type action:ActionPresenter}">
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type action:ActionPresenter}">
					<Grid>
						<Button MinWidth="48"
								MinHeight="36"
								Command="{Binding Command, RelativeSource={RelativeSource AncestorType=action:ActionPresenter}}"
								ToolTip="{Binding Help.Value, RelativeSource={RelativeSource AncestorType=action:ActionPresenter}}">

							<StackPanel Orientation="Horizontal">
								<TextBlock VerticalAlignment="Center"
								           Text="{Binding Label.Value, RelativeSource={RelativeSource AncestorType=action:ActionPresenter}}" />
							</StackPanel>
						</Button>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>