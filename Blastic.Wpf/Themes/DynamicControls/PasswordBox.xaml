<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:controlExtensions="clr-namespace:Blastic.ControlExtensions"
					xmlns:converters="clr-namespace:Blastic.Wpf.Converters"
					xmlns:password="clr-namespace:Blastic.Wpf.DynamicControls.Presenters"
					xmlns:controlExtensions1="clr-namespace:Blastic.Wpf.ControlExtensions"
					xmlns:help="clr-namespace:Blastic.Wpf.Controls.Help">

	<converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

	<Style TargetType="{x:Type password:PasswordPresenter}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type password:PasswordPresenter}">
					<Grid controlExtensions1:GridExtensions.ColumnDefinitions="Auto,*,Auto">
						<PasswordBox Name="PropertyControl"
									 Grid.Column="1"
									 Margin="0,-14,0,0"
									 VerticalAlignment="Center"
									 controlExtensions1:PasswordBoxExtensions.BindPassword="True"
									 controlExtensions1:PasswordBoxExtensions.BoundPassword="{Binding Property.Value, RelativeSource={RelativeSource AncestorType=password:PasswordPresenter}, UpdateSourceTrigger=PropertyChanged}"
									 IsEnabled="{Binding IsEnabledReactive.Value, RelativeSource={RelativeSource AncestorType=password:PasswordPresenter}}" />

						<help:HelpView Grid.Column="2"
									   HelpContent="{Binding Help.Value, RelativeSource={RelativeSource AncestorType=password:PasswordPresenter}}"
									   Visibility="{Binding Help.Value, RelativeSource={RelativeSource AncestorType=password:PasswordPresenter}, Converter={StaticResource NullToVisibilityConverter}}" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>