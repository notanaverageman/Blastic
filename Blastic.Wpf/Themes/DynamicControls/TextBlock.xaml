<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:controlExtensions="clr-namespace:Blastic.Wpf.ControlExtensions"
					xmlns:controls="clr-namespace:Blastic.Wpf.Controls"
					xmlns:converters="clr-namespace:Blastic.Wpf.Converters"
					xmlns:label="clr-namespace:Blastic.Wpf.DynamicControls.Presenters">

	<converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

	<Style TargetType="{x:Type label:LabelPresenter}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type label:LabelPresenter}">
					<Grid controlExtensions:GridExtensions.ColumnDefinitions="Auto,*,Auto">
						<TextBlock Name="PropertyControl"
								   Grid.Column="1"
								   Margin="0,-14,0,0"
								   VerticalAlignment="Center"
								   Text="{Binding Property.Value, RelativeSource={RelativeSource AncestorType=label:LabelPresenter}, UpdateSourceTrigger=PropertyChanged}" />

						<controls:HelpView Grid.Column="2"
										   HelpContent="{Binding Help.Value, RelativeSource={RelativeSource AncestorType=label:LabelPresenter}}"
										   Visibility="{Binding Help.Value, RelativeSource={RelativeSource AncestorType=label:LabelPresenter}, Converter={StaticResource NullToVisibilityConverter}}" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>