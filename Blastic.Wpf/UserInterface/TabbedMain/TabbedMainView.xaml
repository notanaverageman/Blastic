<Window x:Class="Blastic.Wpf.UserInterface.TabbedMain.TabbedMainView"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:execution="clr-namespace:Blastic.Wpf.Execution"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:viewManagement="clr-namespace:Blastic.Wpf.ViewManagement"
		xmlns:converters="clr-namespace:Blastic.Wpf.Converters"
		xmlns:notifications="clr-namespace:Blastic.Wpf.Controls.Notifications"
		xmlns:tabbedMain="clr-namespace:Blastic.Wpf.UserInterface.TabbedMain"
		Title="{Binding ProductInformation.ProgramName.Value}"
		mc:Ignorable="d"
		Width="1000"
		Height="600"
		d:DataContext="{d:DesignInstance tabbedMain:TabbedMainViewModel}"
		Style="{StaticResource WindowStyle}"
		WindowStartupLocation="CenterScreen">

	<Window.Resources>
		<converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
	</Window.Resources>

	<Grid>
		<TabControl ItemsSource="{Binding Items}"
					SelectedItem="{Binding ActiveItem.Value}">

			<TabControl.ItemContainerStyle>
				<Style TargetType="TabItem">
					<Setter Property="Header" Value="{Binding Title.Value}" />
				</Style>
			</TabControl.ItemContainerStyle>

			<TabControl.ContentTemplate>
				<DataTemplate>
					<ContentControl HorizontalContentAlignment="Stretch"
									VerticalContentAlignment="Stretch"
									viewManagement:View.Model="{Binding}"
									IsTabStop="False" />
				</DataTemplate>
			</TabControl.ContentTemplate>
		</TabControl>

		<Grid VerticalAlignment="Top">
			<StackPanel Margin="4"
						HorizontalAlignment="Right"
						Orientation="Horizontal">

				<Button Margin="8,0,0,0"
						Command="{Binding ShowLogsCommand}"
						Content="Logs"
						Visibility="{Binding LogsViewModel, Converter={StaticResource NullToVisibilityConverter}}" />

				<Button Margin="8,0,0,0"
						Command="{Binding ShowSettingsCommand}"
						Content="Settings"
						Visibility="{Binding SettingsViewModel, Converter={StaticResource NullToVisibilityConverter}}" />
			</StackPanel>
		</Grid>

		<execution:ExecutionContextView ExecutionContext="{Binding ExecutionContext}" />
		<notifications:NotificationAreaView HorizontalAlignment="Right"
											VerticalAlignment="Bottom"
											NotificationService="{Binding NotificationService}" />
	</Grid>
</Window>