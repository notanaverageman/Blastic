<Window x:Class="Blastic.Wpf.UserInterface.Settings.SettingsView"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:controlExtensions="clr-namespace:Blastic.Wpf.ControlExtensions"
		xmlns:controls="clr-namespace:Blastic.Wpf.Controls"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:execution="clr-namespace:Blastic.Wpf.Execution"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:settings="clr-namespace:Blastic.Wpf.UserInterface.Settings"
		xmlns:viewManagement="clr-namespace:Blastic.Wpf.ViewManagement"
		Title="Settings"
		mc:Ignorable="d"
		d:DataContext="{d:DesignInstance settings:SettingsViewModel}">

	<Window.InputBindings>
		<KeyBinding Key="Escape"
					Command="{Binding CancelCommand}" />
	</Window.InputBindings>

	<Grid>
		<Grid controlExtensions:GridExtensions.RowDefinitions="*,Auto">
			<ScrollViewer Grid.Row="0"
						  VerticalScrollBarVisibility="Auto">
				<ItemsControl ItemsSource="{Binding Items}">
					<ItemsControl.ItemTemplate>
						<DataTemplate DataType="settings:SettingsSectionViewModel">
							<Expander Header="{Binding SectionName}"
									  IsExpanded="{Binding IsExpanded.ReactiveSettingValue.Value}">
								<ContentControl Margin="32,-8,24,16"
												HorizontalContentAlignment="Stretch"
												VerticalContentAlignment="Stretch"
												viewManagement:View.Model="{Binding}"
												Grid.IsSharedSizeScope="True"
												IsTabStop="False" />
							</Expander>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>

			<StackPanel Grid.Row="1"
						Margin="0,8,16,8"
						HorizontalAlignment="Right"
						Orientation="Horizontal">

				<Button Command="{Binding SaveCommand}"
						Content="Save" />

				<Button Margin="8,0,0,0"
						Command="{Binding CancelCommand}"
						Content="Cancel" />
			</StackPanel>
		</Grid>

		<controls:ChildWindow IsOpen="{Binding IsDiagnosticMessagesVisible.Value}">
			<Grid Margin="16">
				<Grid MinWidth="600"
					  MinHeight="400"
					  controlExtensions:GridExtensions.RowDefinitions="Auto,*,Auto">

					<TextBlock Grid.Row="0"
							   Text="There are some errors that should be corrected:" />

					<ScrollViewer Grid.Row="1"
								  Margin="8,8,0,0"
								  VerticalScrollBarVisibility="Auto">
						<ItemsControl ItemsSource="{Binding DiagnosticMessages}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<ContentControl Content="{Binding}" />
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>

					<StackPanel Grid.Row="2"
								HorizontalAlignment="Right"
								Orientation="Horizontal">

						<Button Command="{Binding HideDiagnosticMessagesIgnoreErrorsCommand}"
								Content="Save Anyways" />

						<Button Command="{Binding HideDiagnosticMessagesCommand}"
								Content="Cancel" />
					</StackPanel>
				</Grid>
			</Grid>
		</controls:ChildWindow>

		<execution:ExecutionContextView ExecutionContext="{Binding ExecutionContext}" />
	</Grid>
</Window>