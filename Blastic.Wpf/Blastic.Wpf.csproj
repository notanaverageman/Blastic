<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
	<TargetFramework>netcoreapp3.1</TargetFramework>
	<UseWPF>true</UseWPF>
	<LangVersion>preview</LangVersion>
	<ContentSQLiteInteropFiles>true</ContentSQLiteInteropFiles>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="3.1.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="3.1.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="3.1.0" />
    <PackageReference Include="NuGet.Build.Tasks.Pack" Version="5.3.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.Reactive" Version="4.3.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Blastic\Blastic.csproj" />
    <ProjectReference Include="..\Blastic.Data\Blastic.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Controls\ChildWindow.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.tr-tr.resx">
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Page Update="Themes\NotificationAreaView.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Themes\BusyIndicator.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Themes\ChildWindow.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Themes\DualView.xaml">
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>
</Project>