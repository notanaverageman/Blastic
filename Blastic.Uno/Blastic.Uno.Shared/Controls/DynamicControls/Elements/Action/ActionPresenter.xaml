<elements:Presenter x:Class="Blastic.Uno.Shared.Controls.DynamicControls.Elements.Action.ActionPresenter"
					xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:converters="using:Blastic.Converters"
					xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
					xmlns:elements="using:Blastic.Controls.DynamicControls.Elements"
					xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
					Name="Root"
					mc:Ignorable="d"
					IsTabStop="False">

	<elements:Presenter.Resources>
		<converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
	</elements:Presenter.Resources>

	<Grid>
		<Button Name="Button"
				MinWidth="48"
				MinHeight="36"
				Command="{Binding Command, ElementName=Root}"
				ToolTipService.ToolTip="{Binding Help.Value, ElementName=Root}">

			<StackPanel Orientation="Horizontal">
				<SymbolIcon Width="{Binding IconSize, ElementName=Root}"
							Height="{Binding IconSize, ElementName=Root}"
							Margin="{Binding IconMargin, ElementName=Root}"
							Symbol="{Binding Icon.Value, ElementName=Root}"
							Visibility="{Binding Icon.Value, ElementName=Root, Converter={StaticResource NullToVisibilityConverter}}" />

				<TextBlock VerticalAlignment="Center"
						   Text="{Binding Label.Value, ElementName=Root}" />
			</StackPanel>
		</Button>
	</Grid>
</elements:Presenter>