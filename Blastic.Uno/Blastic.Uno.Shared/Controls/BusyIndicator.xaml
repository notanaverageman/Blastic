<UserControl x:Class="Blastic.Controls.BusyIndicator"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:controlExtensions="using:Blastic.ControlExtensions"
			 xmlns:controls="using:Blastic.Uno.Shared.Controls"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d">

	<controls:ChildWindow IsOpen="{x:Bind ExecutionContext.IsBusy.Value, Mode=OneWay}">

		<Grid Margin="8,16,8,8"
			  controlExtensions:GridExtensions.RowDefinitions="Auto,*,Auto,Auto">

			<TextBlock Grid.Row="0"
					   MinWidth="400"
					   MaxWidth="600"
					   HorizontalAlignment="Left"
					   VerticalAlignment="Center"
					   Text="{x:Bind ExecutionContext.ProgressMessage.Value, Mode=OneWay}" />

			<ScrollViewer Grid.Row="1"
						  MaxHeight="400"
						  Margin="8,8,0,0"
						  controlExtensions:ScrollViewerExtensions.AutoScroll="True"
						  VerticalScrollBarVisibility="Auto">
				<ItemsControl ItemsSource="{x:Bind ExecutionContext.ProgressDetails, Mode=OneWay}" />
			</ScrollViewer>

			<ProgressBar Grid.Row="2"
						 Margin="0,24,0,8"
						 VerticalAlignment="Center"
						 IsIndeterminate="True" />

			<Button Grid.Row="3"
					HorizontalAlignment="Right"
					Command="{x:Bind Cancel}"
					Content="Cancel"
					IsEnabled="{x:Bind ExecutionContext.IsCancellationSupported.Value, Mode=OneWay}" />
		</Grid>
	</controls:ChildWindow>
</UserControl>