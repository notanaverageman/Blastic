<elements:Presenter x:Class="Blastic.Uno.Shared.Controls.DynamicControls.Elements.Text.TextPresenter"
					xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:controlExtensions="using:Blastic.ControlExtensions"
					xmlns:converters="using:Blastic.Converters"
					xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
					xmlns:elements="using:Blastic.Controls.DynamicControls.Elements"
					xmlns:help="using:Blastic.Uno.Shared.Controls.Help"
					xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
					mc:Ignorable="d"
					IsTabStop="False">

	<elements:Presenter.Resources>
		<converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
	</elements:Presenter.Resources>

	<Grid controlExtensions:GridExtensions.ColumnDefinitions="Auto,*,Auto">
		<SymbolIcon Grid.Column="0"
					Width="{x:Bind IconSize}"
					Height="{x:Bind IconSize}"
					Margin="{x:Bind IconMargin}"
					Symbol="{x:Bind Icon.Value.Value}"
					Visibility="{x:Bind Icon.Value, Converter={StaticResource NullToVisibilityConverter}}" />

		<TextBox Grid.Column="1"
				 VerticalAlignment="Center"
				 controlExtensions:TextBoxMasking.Mask="{x:Bind Mask.Value}"
				 IsEnabled="{x:Bind IsEnabledReactive.Value}"
				 PlaceholderText="{x:Bind Label.Value}"
				 Text="{x:Bind Property.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

		<help:HelpView Grid.Column="2"
					   HelpContent="{x:Bind Help.Value}"
					   Visibility="{x:Bind Help.Value, Converter={StaticResource NullToVisibilityConverter}}" />
	</Grid>
</elements:Presenter>
