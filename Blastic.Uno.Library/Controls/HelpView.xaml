<UserControl x:Class="Blastic.Uno.Shared.Controls.Help.HelpView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:controlExtensions="using:Blastic.ControlExtensions"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d">

	<Grid Margin="{x:Bind Padding}"
		  controlExtensions:GridExtensions.ColumnDefinitions="*,Auto">


		<Button Margin="{x:Bind HelpIconMargin}">
			<Button.Flyout>
				<Flyout>
					<ContentPresenter VerticalAlignment="{x:Bind VerticalContentAlignment}"
									  Content="{x:Bind HelpContent, Mode=OneWay}"
									  TextWrapping="Wrap" />
				</Flyout>
			</Button.Flyout>

			<SymbolIcon Symbol="Help" />
		</Button>
	</Grid>
</UserControl>