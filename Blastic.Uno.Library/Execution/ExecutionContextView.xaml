<UserControl x:Class="Blastic.Execution.ExecutionContextView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:controls="using:Blastic.Controls"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:dynamicControls="using:Blastic.Controls.DynamicControls"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d">
	<Grid>
		<dynamicControls:Form ExecutionContext="{x:Bind ExecutionContext}" />

		<controls:BusyIndicator ExecutionContext="{x:Bind ExecutionContext}" />
	</Grid>
</UserControl>