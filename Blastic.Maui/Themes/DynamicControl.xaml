<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary x:Class="Blastic.Maui.Themes.DynamicControl"
					xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
					xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
					xmlns:dynamicControls="clr-namespace:Blastic.Maui.DynamicControls;assembly=Blastic.Maui">

	<Style TargetType="{x:Type dynamicControls:DynamicControl}">
		<Setter Property="ControlTemplate">
			<Setter.Value>
				<ControlTemplate>
					<Grid x:Name="PART_RootGrid"
						  Margin="{TemplateBinding Padding}" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>