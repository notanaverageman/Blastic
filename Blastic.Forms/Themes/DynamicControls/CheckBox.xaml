<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary x:Class="Blastic.Forms.Themes.DynamicControls.CheckBox"
					xmlns="http://xamarin.com/schemas/2014/forms"
					xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
					xmlns:controlExtensions="clr-namespace:Blastic.Forms.ControlExtensions;assembly=Blastic.Forms"
					xmlns:presenters="clr-namespace:Blastic.Forms.DynamicControls.Presenters;assembly=Blastic.Forms">

	<Style TargetType="{x:Type presenters:BooleanPresenter}">
		<Setter Property="VerticalOptions" Value="Center" />
		<Setter Property="ControlTemplate">
			<Setter.Value>
				<ControlTemplate>
					<Grid controlExtensions:GridExtensions.ColumnDefinitions="*,Auto">
						<Label Grid.Column="0"
							   Text="{TemplateBinding Label.Value}"
							   VerticalOptions="Center" />

						<Switch x:Name="Switch"
								Grid.Column="1"
								IsEnabled="{TemplateBinding IsEnabledReactive.Value}"
								IsToggled="{TemplateBinding Property.Value}"
								VerticalOptions="Center" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>