<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary x:Class="Blastic.Forms.Themes.ChildWindow"
					xmlns="http://xamarin.com/schemas/2014/forms"
					xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
					xmlns:controls="clr-namespace:Blastic.Forms.Controls;assembly=Blastic.Forms"
					xmlns:themes="clr-namespace:Blastic.Forms.Themes;assembly=Blastic.Forms">

	<ResourceDictionary.MergedDictionaries>
		<themes:Colors />
	</ResourceDictionary.MergedDictionaries>

	<Style TargetType="{x:Type controls:ChildWindow}">
		<Setter Property="OverlayColor" Value="{StaticResource BlasticGrayColorMedium}" />
		<Setter Property="BackgroundColor" Value="{StaticResource BlasticWhiteColor}" />

		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate>
					<Grid x:Name="PART_Overlay"
						  BackgroundColor="{TemplateBinding OverlayColor}"
						  IsVisible="{TemplateBinding IsOpen}">
						<Grid x:Name="PART_Window"
							  Margin="{TemplateBinding Padding}"
							  BackgroundColor="{TemplateBinding BackgroundColor}"
							  HorizontalOptions="Center"
							  VerticalOptions="Center">

							<Frame x:Name="PART_Border"
								   BackgroundColor="{x:Null}"
								   HasShadow="True" />

							<ContentPresenter x:Name="PART_Content"
											  Content="{TemplateBinding Content}" />
						</Grid>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>