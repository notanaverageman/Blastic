<UserControl x:Class="Blastic.Controls.Notifications.NotificationView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:controlExtensions="clr-namespace:Blastic.ControlExtensions"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:dynamicControls="clr-namespace:Blastic.Controls.DynamicControls"
			 xmlns:local="clr-namespace:Blastic.Controls.Notifications"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:notifications="clr-namespace:Blastic.Services.Notifications"
			 d:DataContext="{d:DesignInstance notifications:Notification}"
			 mc:Ignorable="d">
	<Grid>
		<materialDesign:Card>
			<Grid controlExtensions:GridExtensions.RowDefinitions="Auto,*">
				<Button Grid.Row="0"
						HorizontalAlignment="Right"
						Command="{Binding Dismiss}"
						Style="{StaticResource MaterialDesignToolButton}">
					<materialDesign:PackIcon Kind="Close" />
				</Button>

				<dynamicControls:DynamicControl Grid.Row="1"
												Model="{Binding Notification.Model, RelativeSource={RelativeSource AncestorType=local:NotificationView}}" />
			</Grid>
		</materialDesign:Card>
	</Grid>
</UserControl>