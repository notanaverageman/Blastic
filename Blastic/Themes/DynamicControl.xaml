<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:cal="http://www.caliburnproject.org"
					xmlns:local="clr-namespace:Blastic.Controls.DynamicControls"
					xmlns:simpleChildWindow="clr-namespace:MahApps.Metro.SimpleChildWindow;assembly=MahApps.Metro.SimpleChildWindow">
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/materialdesigntheme.TextBox.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<Style TargetType="{x:Type local:DynamicControl}">
		<Setter Property="Padding" Value="16" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type local:DynamicControl}">
					<simpleChildWindow:ChildWindow cal:Action.TargetWithoutContext="{Binding RelativeSource={RelativeSource AncestorType=local:DynamicControl}}"
												   cal:Message.Attach="[Key Escape] = [Cancel]"
												   CloseByEscape="False"
												   IsOpen="{Binding ExecutionContext.IsShowingForm, RelativeSource={RelativeSource AncestorType=local:DynamicControl}}"
												   ShowTitleBar="False">
						<simpleChildWindow:ChildWindow.Resources>
							<Style BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}"
								   TargetType="TextBox" />
						</simpleChildWindow:ChildWindow.Resources>

						<Grid Name="PART_RootGrid"
							  Margin="{TemplateBinding Padding}"
							  MinWidth="400"
							  MinHeight="200"/>
					</simpleChildWindow:ChildWindow>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>