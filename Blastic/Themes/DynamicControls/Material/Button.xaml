<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:action="clr-namespace:Blastic.Controls.DynamicControls.Elements.Action"
					xmlns:controlExtensions="clr-namespace:Blastic.ControlExtensions"
					xmlns:converters="clr-namespace:Blastic.Converters"
					xmlns:help="clr-namespace:Blastic.Controls.Help"
					xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Blastic;component/Themes/DynamicControls/Material/Common.xaml" />
		<ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/materialdesigntheme.Button.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

	<Style TargetType="{x:Type action:ActionPresenter}">
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type action:ActionPresenter}">
					<Grid>
						<Button MinWidth="48"
								MinHeight="36"
								Command="{Binding Command, RelativeSource={RelativeSource AncestorType=action:ActionPresenter}}"
								Style="{StaticResource MaterialDesignFlatButton}"
								ToolTip="{Binding Help.Value, RelativeSource={RelativeSource AncestorType=action:ActionPresenter}}">

							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=action:ActionPresenter}}"
														 Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=action:ActionPresenter}}"
														 Margin="{Binding IconMargin, RelativeSource={RelativeSource AncestorType=action:ActionPresenter}}"
														 Kind="{Binding IconKind.Value, RelativeSource={RelativeSource AncestorType=action:ActionPresenter}}"
														 Visibility="{Binding IconKind.Value, RelativeSource={RelativeSource AncestorType=action:ActionPresenter}, Converter={StaticResource NullToVisibilityConverter}}" />

								<TextBlock VerticalAlignment="Center"
										   Text="{Binding Label.Value, RelativeSource={RelativeSource AncestorType=action:ActionPresenter}}" />
							</StackPanel>
						</Button>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>