<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:controlExtensions="clr-namespace:Blastic.ControlExtensions"
					xmlns:converters="clr-namespace:Blastic.Converters"
					xmlns:help="clr-namespace:Blastic.Controls.Help"
					xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
					xmlns:text="clr-namespace:Blastic.Controls.DynamicControls.Elements.Text">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Blastic;component/Themes/DynamicControls/Material/Common.xaml" />
		<ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/materialdesigntheme.TextBox.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

	<Style TargetType="{x:Type text:TextPresenter}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type text:TextPresenter}">
					<Grid controlExtensions:GridExtensions.ColumnDefinitions="Auto,*,Auto">
						<materialDesign:PackIcon Grid.Column="0"
												 Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=text:TextPresenter}}"
												 Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=text:TextPresenter}}"
												 Margin="{Binding IconMargin, RelativeSource={RelativeSource AncestorType=text:TextPresenter}}"
												 Kind="{Binding IconKind.Value, RelativeSource={RelativeSource AncestorType=text:TextPresenter}}"
												 Style="{StaticResource MaterialColoredIconStyle}"
												 Visibility="{Binding IconKind.Value, RelativeSource={RelativeSource AncestorType=text:TextPresenter}, Converter={StaticResource NullToVisibilityConverter}}" />

						<TextBox Name="PropertyControl"
								 Grid.Column="1"
								 Margin="0,-14,0,0"
								 VerticalAlignment="Center"
								 controlExtensions:TextBoxMasking.Mask="{Binding Mask.Value, RelativeSource={RelativeSource AncestorType=text:TextPresenter}}"
								 materialDesign:HintAssist.Hint="{Binding Label.Value, RelativeSource={RelativeSource AncestorType=text:TextPresenter}}"
								 IsEnabled="{Binding IsEnabledReactive.Value, RelativeSource={RelativeSource AncestorType=text:TextPresenter}}"
								 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
								 Text="{Binding Property.Value, RelativeSource={RelativeSource AncestorType=text:TextPresenter}, UpdateSourceTrigger=PropertyChanged}" />

						<help:HelpView Grid.Column="2"
									   HelpContent="{Binding Help.Value, RelativeSource={RelativeSource AncestorType=text:TextPresenter}}"
									   Visibility="{Binding Help.Value, RelativeSource={RelativeSource AncestorType=text:TextPresenter}, Converter={StaticResource NullToVisibilityConverter}}" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>