<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:controlExtensions="clr-namespace:Blastic.ControlExtensions"
					xmlns:converters="clr-namespace:Blastic.Converters"
					xmlns:help="clr-namespace:Blastic.Controls.Help"
					xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
					xmlns:password="clr-namespace:Blastic.Controls.DynamicControls.Elements.Password">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Blastic;component/Themes/DynamicControls/Material/Common.xaml" />
		<ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/materialdesigntheme.PasswordBox.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

	<Style TargetType="{x:Type password:PasswordPresenter}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type password:PasswordPresenter}">
					<Grid controlExtensions:GridExtensions.ColumnDefinitions="Auto,*,Auto">
						<materialDesign:PackIcon Grid.Column="0"
												 Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=password:PasswordPresenter}}"
												 Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=password:PasswordPresenter}}"
												 Margin="{Binding IconMargin, RelativeSource={RelativeSource AncestorType=password:PasswordPresenter}}"
												 Kind="{Binding IconKind.Value, RelativeSource={RelativeSource AncestorType=password:PasswordPresenter}}"
												 Style="{StaticResource MaterialColoredIconStyle}"
												 Visibility="{Binding IconKind.Value, RelativeSource={RelativeSource AncestorType=password:PasswordPresenter}, Converter={StaticResource NullToVisibilityConverter}}" />

						<PasswordBox Name="PropertyControl"
									 Grid.Column="1"
									 Margin="0,-14,0,0"
									 VerticalAlignment="Center"
									 IsEnabled="{Binding IsEnabledReactive.Value, RelativeSource={RelativeSource AncestorType=password:PasswordPresenter}}"
									 controlExtensions:PasswordBoxExtensions.BindPassword="True"
									 controlExtensions:PasswordBoxExtensions.BoundPassword="{Binding Property.Value, RelativeSource={RelativeSource AncestorType=password:PasswordPresenter}, UpdateSourceTrigger=PropertyChanged}"
									 materialDesign:HintAssist.Hint="{Binding Label.Value, RelativeSource={RelativeSource AncestorType=password:PasswordPresenter}}"
									 Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" />

						<help:HelpView Grid.Column="2"
									   HelpContent="{Binding Help.Value, RelativeSource={RelativeSource AncestorType=password:PasswordPresenter}}"
									   Visibility="{Binding Help.Value, RelativeSource={RelativeSource AncestorType=password:PasswordPresenter}, Converter={StaticResource NullToVisibilityConverter}}" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>