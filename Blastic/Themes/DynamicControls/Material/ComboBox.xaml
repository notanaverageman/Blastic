<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:controlExtensions="clr-namespace:Blastic.ControlExtensions"
					xmlns:converters="clr-namespace:Blastic.Converters"
					xmlns:help="clr-namespace:Blastic.Controls.Help"
					xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
					xmlns:selection="clr-namespace:Blastic.Controls.DynamicControls.Elements.Selection">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Blastic;component/Themes/DynamicControls/Material/Common.xaml" />
		<ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/materialdesigntheme.ComboBox.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

	<Style TargetType="{x:Type selection:SelectionPresenter}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type selection:SelectionPresenter}">
					<Grid controlExtensions:GridExtensions.ColumnDefinitions="Auto,*,Auto">
						<materialDesign:PackIcon Grid.Column="0"
												 Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=selection:SelectionPresenter}}"
												 Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=selection:SelectionPresenter}}"
												 Margin="{Binding IconMargin, RelativeSource={RelativeSource AncestorType=selection:SelectionPresenter}}"
												 Kind="{Binding IconKind.Value, RelativeSource={RelativeSource AncestorType=selection:SelectionPresenter}}"
												 Style="{StaticResource MaterialColoredIconStyle}"
												 Visibility="{Binding IconKind.Value, RelativeSource={RelativeSource AncestorType=selection:SelectionPresenter}, Converter={StaticResource NullToVisibilityConverter}}" />

						<ComboBox Name="PropertyControl"
								  Grid.Column="1"
								  VerticalAlignment="Center"
								  materialDesign:HintAssist.Hint="{Binding Label.Value, RelativeSource={RelativeSource AncestorType=selection:SelectionPresenter}}"
								  SelectedItem="{Binding Property.Value, RelativeSource={RelativeSource AncestorType=selection:SelectionPresenter}}"
								  ItemsSource="{Binding Values, RelativeSource={RelativeSource AncestorType=selection:SelectionPresenter}}"
								  IsEnabled="{Binding IsEnabledReactive.Value, RelativeSource={RelativeSource AncestorType=selection:SelectionPresenter}}"
								  Style="{StaticResource MaterialDesignFloatingHintComboBox}" />

						<help:HelpView Grid.Column="2"
									   HelpContent="{Binding Help.Value, RelativeSource={RelativeSource AncestorType=selection:SelectionPresenter}}"
									   Visibility="{Binding Help.Value, RelativeSource={RelativeSource AncestorType=selection:SelectionPresenter}, Converter={StaticResource NullToVisibilityConverter}}" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>