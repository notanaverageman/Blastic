<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:boolean="clr-namespace:Blastic.Controls.DynamicControls.Elements.Boolean"
					xmlns:controlExtensions="clr-namespace:Blastic.ControlExtensions"
					xmlns:converters="clr-namespace:Blastic.Converters"
					xmlns:help="clr-namespace:Blastic.Controls.Help"
					xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Blastic;component/Themes/DynamicControls/Material/Common.xaml" />
		<ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/materialdesigntheme.CheckBox.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

	<Style TargetType="{x:Type boolean:BooleanPresenter}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type boolean:BooleanPresenter}">
					<Grid controlExtensions:GridExtensions.ColumnDefinitions="Auto,*,Auto">
						<materialDesign:PackIcon Grid.Column="0"
												 Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=boolean:BooleanPresenter}}"
												 Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=boolean:BooleanPresenter}}"
												 Margin="{Binding IconMargin, RelativeSource={RelativeSource AncestorType=boolean:BooleanPresenter}}"
												 Kind="{Binding IconKind.Value, RelativeSource={RelativeSource AncestorType=boolean:BooleanPresenter}}"
												 Style="{StaticResource MaterialColoredIconStyle}"
												 Visibility="{Binding IconKind.Value, RelativeSource={RelativeSource AncestorType=boolean:BooleanPresenter}, Converter={StaticResource NullToVisibilityConverter}}" />

						<CheckBox Name="PropertyControl"
								  Grid.Column="1"
								  Padding="8,0,8,0"
								  VerticalAlignment="Center"
								  Content="{Binding Label.Value, RelativeSource={RelativeSource AncestorType=boolean:BooleanPresenter}}"
								  IsChecked="{Binding Property.Value, RelativeSource={RelativeSource AncestorType=boolean:BooleanPresenter}}"
								  IsEnabled="{Binding IsEnabledReactive.Value, RelativeSource={RelativeSource AncestorType=boolean:BooleanPresenter}}"
								  Style="{StaticResource MaterialDesignCheckBox}" />

						<help:HelpView Grid.Column="2"
									   HelpContent="{Binding Help.Value, RelativeSource={RelativeSource AncestorType=boolean:BooleanPresenter}}"
									   Visibility="{Binding Help.Value, RelativeSource={RelativeSource AncestorType=boolean:BooleanPresenter}, Converter={StaticResource NullToVisibilityConverter}}" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>