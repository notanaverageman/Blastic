<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:controlExtensions="clr-namespace:Blastic.Wpf.ControlExtensions;assembly=Blastic.Wpf"
					xmlns:converters="clr-namespace:Blastic.Wpf.Converters;assembly=Blastic.Wpf"
					xmlns:help="clr-namespace:Blastic.Wpf.Controls.Help;assembly=Blastic.Wpf"
					xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
					xmlns:presenters="clr-namespace:Blastic.Wpf.DynamicControls.Presenters;assembly=Blastic.Wpf">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Blastic.Wpf.Material;component/Themes/DynamicControls/Material/Common.xaml" />
		<ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/materialdesigntheme.TextBox.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

	<Style TargetType="{x:Type presenters:LabelPresenter}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type presenters:LabelPresenter}">
					<Grid controlExtensions:GridExtensions.ColumnDefinitions="Auto,*,Auto">
						<materialDesign:PackIcon Grid.Column="0"
												 Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=presenters:LabelPresenter}}"
												 Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=presenters:LabelPresenter}}"
												 Margin="{Binding IconMargin, RelativeSource={RelativeSource AncestorType=presenters:LabelPresenter}}"
												 Kind="{Binding Icon.Value, RelativeSource={RelativeSource AncestorType=presenters:LabelPresenter}}"
												 Style="{StaticResource MaterialColoredIconStyle}"
												 Visibility="{Binding Icon.Value, RelativeSource={RelativeSource AncestorType=presenters:LabelPresenter}, Converter={StaticResource NullToVisibilityConverter}}" />

						<TextBlock Name="PropertyControl"
								   Grid.Column="1"
								   Margin="0,-14,0,0"
								   VerticalAlignment="Center"
								   Text="{Binding Property.Value, RelativeSource={RelativeSource AncestorType=presenters:LabelPresenter}, UpdateSourceTrigger=PropertyChanged}" />

						<help:HelpView Grid.Column="2"
									   HelpContent="{Binding Help.Value, RelativeSource={RelativeSource AncestorType=presenters:LabelPresenter}}"
									   Visibility="{Binding Help.Value, RelativeSource={RelativeSource AncestorType=presenters:LabelPresenter}, Converter={StaticResource NullToVisibilityConverter}}" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>