<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:converters="clr-namespace:Blastic.Wpf.Converters;assembly=Blastic.Wpf"
					xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
					xmlns:presenters="clr-namespace:Blastic.Wpf.DynamicControls.Presenters;assembly=Blastic.Wpf">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Blastic.Wpf.Material;component/Themes/DynamicControls/Material/Common.xaml" />
		<ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/materialdesigntheme.Button.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

	<Style TargetType="{x:Type presenters:ActionPresenter}">
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type presenters:ActionPresenter}">
					<Grid>
						<Button MinWidth="48"
								MinHeight="36"
								Command="{Binding Command, RelativeSource={RelativeSource AncestorType=presenters:ActionPresenter}}"
								Style="{StaticResource MaterialDesignFlatButton}"
								ToolTip="{Binding Help.Value, RelativeSource={RelativeSource AncestorType=presenters:ActionPresenter}}">

							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=presenters:ActionPresenter}}"
														 Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=presenters:ActionPresenter}}"
														 Margin="{Binding IconMargin, RelativeSource={RelativeSource AncestorType=presenters:ActionPresenter}}"
														 Kind="{Binding Icon.Value, RelativeSource={RelativeSource AncestorType=presenters:ActionPresenter}}"
														 Visibility="{Binding Icon.Value, RelativeSource={RelativeSource AncestorType=presenters:ActionPresenter}, Converter={StaticResource NullToVisibilityConverter}}" />

								<TextBlock VerticalAlignment="Center"
										   Text="{Binding Label.Value, RelativeSource={RelativeSource AncestorType=presenters:ActionPresenter}}" />
							</StackPanel>
						</Button>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>