<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:controlExtensions="clr-namespace:Blastic.Wpf.ControlExtensions;assembly=Blastic.Wpf"
					xmlns:converters="clr-namespace:Blastic.Wpf.Converters;assembly=Blastic.Wpf"
					xmlns:help="clr-namespace:Blastic.Wpf.Controls.Help;assembly=Blastic.Wpf"
					xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
					xmlns:presenters="clr-namespace:Blastic.Wpf.DynamicControls.Presenters;assembly=Blastic.Wpf">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Blastic.Wpf.Material;component/Themes/DynamicControls/Material/Common.xaml" />
		<ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/materialdesigntheme.CheckBox.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

	<Style TargetType="{x:Type presenters:BooleanPresenter}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type presenters:BooleanPresenter}">
					<Grid controlExtensions:GridExtensions.ColumnDefinitions="Auto,*,Auto">
						<materialDesign:PackIcon Grid.Column="0"
												 Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=presenters:BooleanPresenter}}"
												 Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=presenters:BooleanPresenter}}"
												 Margin="{Binding IconMargin, RelativeSource={RelativeSource AncestorType=presenters:BooleanPresenter}}"
												 Kind="{Binding Icon.Value, RelativeSource={RelativeSource AncestorType=presenters:BooleanPresenter}}"
												 Style="{StaticResource MaterialColoredIconStyle}"
												 Visibility="{Binding Icon.Value, RelativeSource={RelativeSource AncestorType=presenters:BooleanPresenter}, Converter={StaticResource NullToVisibilityConverter}}" />

						<CheckBox Name="PropertyControl"
								  Grid.Column="1"
								  Padding="8,0,8,0"
								  VerticalAlignment="Center"
								  Content="{Binding Label.Value, RelativeSource={RelativeSource AncestorType=presenters:BooleanPresenter}}"
								  IsChecked="{Binding Property.Value, RelativeSource={RelativeSource AncestorType=presenters:BooleanPresenter}}"
								  IsEnabled="{Binding IsEnabledReactive.Value, RelativeSource={RelativeSource AncestorType=presenters:BooleanPresenter}}"
								  Style="{StaticResource MaterialDesignCheckBox}" />

						<help:HelpView Grid.Column="2"
									   HelpContent="{Binding Help.Value, RelativeSource={RelativeSource AncestorType=presenters:BooleanPresenter}}"
									   Visibility="{Binding Help.Value, RelativeSource={RelativeSource AncestorType=presenters:BooleanPresenter}, Converter={StaticResource NullToVisibilityConverter}}" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>