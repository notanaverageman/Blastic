<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

	<Style x:Key="MaterialColoredIconStyle"
		   TargetType="{x:Type materialDesign:PackIcon}">

		<Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}" />
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="VerticalAlignment" Value="Center" />

		<Style.Triggers>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition Binding="{Binding ElementName=PropertyControl, Path=IsFocused}" Value="True" />
					<Condition Binding="{Binding ElementName=PropertyControl, Path=(Validation.HasError)}" Value="False" />
				</MultiDataTrigger.Conditions>

				<Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}" />
			</MultiDataTrigger>

			<DataTrigger Binding="{Binding ElementName=PropertyControl, Path=(Validation.HasError)}"
						 Value="True">
				<Setter Property="Foreground" Value="{DynamicResource ValidationErrorBrush}" />
			</DataTrigger>
		</Style.Triggers>
	</Style>
</ResourceDictionary>