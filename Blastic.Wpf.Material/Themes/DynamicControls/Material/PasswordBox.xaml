<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:controlExtensions="clr-namespace:Blastic.Wpf.ControlExtensions;assembly=Blastic.Wpf"
					xmlns:controls="clr-namespace:Blastic.Wpf.Controls;assembly=Blastic.Wpf"
					xmlns:converters="clr-namespace:Blastic.Wpf.Converters;assembly=Blastic.Wpf"
					xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
					xmlns:presenters="clr-namespace:Blastic.Wpf.DynamicControls.Presenters;assembly=Blastic.Wpf">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Blastic.Wpf.Material;component/Themes/DynamicControls/Material/Common.xaml" />
		<ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/materialdesigntheme.PasswordBox.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

	<Style TargetType="{x:Type presenters:PasswordPresenter}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type presenters:PasswordPresenter}">
					<Grid controlExtensions:GridExtensions.ColumnDefinitions="Auto,*,Auto">
						<materialDesign:PackIcon Grid.Column="0"
												 Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=presenters:PasswordPresenter}}"
												 Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=presenters:PasswordPresenter}}"
												 Margin="{Binding IconMargin, RelativeSource={RelativeSource AncestorType=presenters:PasswordPresenter}}"
												 Kind="{Binding Icon.Value, RelativeSource={RelativeSource AncestorType=presenters:PasswordPresenter}}"
												 Style="{StaticResource MaterialColoredIconStyle}"
												 Visibility="{Binding Icon.Value, RelativeSource={RelativeSource AncestorType=presenters:PasswordPresenter}, Converter={StaticResource NullToVisibilityConverter}}" />

						<PasswordBox Name="PropertyControl"
									 Grid.Column="1"
									 Margin="0,-14,0,0"
									 VerticalAlignment="Center"
									 controlExtensions:PasswordBoxExtensions.BindPassword="True"
									 controlExtensions:PasswordBoxExtensions.BoundPassword="{Binding Property.Value, RelativeSource={RelativeSource AncestorType=presenters:PasswordPresenter}, UpdateSourceTrigger=PropertyChanged}"
									 materialDesign:HintAssist.Hint="{Binding Label.Value, RelativeSource={RelativeSource AncestorType=presenters:PasswordPresenter}}"
									 IsEnabled="{Binding IsEnabledReactive.Value, RelativeSource={RelativeSource AncestorType=presenters:PasswordPresenter}}"
									 Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" />

						<controls:HelpView Grid.Column="2"
										   HelpContent="{Binding Help.Value, RelativeSource={RelativeSource AncestorType=presenters:PasswordPresenter}}"
										   Visibility="{Binding Help.Value, RelativeSource={RelativeSource AncestorType=presenters:PasswordPresenter}, Converter={StaticResource NullToVisibilityConverter}}" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>