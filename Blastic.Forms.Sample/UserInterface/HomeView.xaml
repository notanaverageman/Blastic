<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Blastic.Forms.Sample.UserInterface.HomeView"
			 xmlns="http://xamarin.com/schemas/2014/forms"
			 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:controlExtensions="clr-namespace:Blastic.Forms.ControlExtensions;assembly=Blastic.Forms"
			 xmlns:d="http://xamarin.com/schemas/2014/forms/design"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:userInterface="clr-namespace:Blastic.Forms.Sample.UserInterface;assembly=Blastic.Forms.Sample"
			 mc:Ignorable="d"
			 x:DataType="userInterface:HomeViewModel">

	<Grid Margin="8,0"
		  controlExtensions:GridExtensions.RowDefinitions="Auto,*">
		<Button Grid.Row="0"
				Command="{Binding AddMachineCommand}"
				Text="{Binding AddMachineLabel.Value}" />

		<CollectionView Grid.Row="1"
						ItemsSource="{Binding Machines}"
						SelectedItem="{Binding SelectedMachine.Value}"
						SelectionMode="Single">
			<CollectionView.ItemTemplate>
				<DataTemplate x:DataType="userInterface:MachineViewModel">
					<Grid Padding="10">
						<StackLayout>
							<Label FontAttributes="Bold"
								   FontSize="Medium"
								   Text="{Binding Machine.Name.Value}" />
							<Label FontSize="Small"
								   HorizontalOptions="End"
								   Text="{Binding Machine.SecondsPerFrame.Value}" />

							<ProgressBar Progress="0.2" />

							<BoxView HeightRequest="1"
									 Color="{StaticResource BlasticGrayColorMedium}" />
						</StackLayout>
					</Grid>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>
	</Grid>
</ContentPage>