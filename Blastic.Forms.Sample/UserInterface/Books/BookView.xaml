<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Blastic.Forms.Sample.UserInterface.Books.BookView"
			 xmlns="http://xamarin.com/schemas/2014/forms"
			 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:books="clr-namespace:Blastic.Forms.Sample.UserInterface.Books;assembly=Blastic.Forms.Sample"
			 xmlns:chapters="clr-namespace:Blastic.Forms.Sample.UserInterface.Chapters;assembly=Blastic.Forms.Sample"
			 xmlns:controlExtensions="clr-namespace:Blastic.Forms.ControlExtensions;assembly=Blastic.Forms"
			 xmlns:controls="clr-namespace:Blastic.Forms.Sample.Controls;assembly=Blastic.Forms.Sample"
			 xmlns:d="http://xamarin.com/schemas/2014/forms/design"
			 xmlns:icons="clr-namespace:Blastic.Forms.Sample.Icons;assembly=Blastic.Forms.Sample"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:pancakeView="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
			 x:Name="Root"
			 Title="{Binding Title.Value}"
			 mc:Ignorable="d"
			 x:DataType="books:BookViewModel"
			 Style="{StaticResource PageStyle}">

	<CollectionView Margin="15,0"
					ItemSizingStrategy="MeasureFirstItem"
					ItemsSource="{Binding Chapters, Mode=OneTime}">
		<CollectionView.Header>
			<StackLayout>
				<StackLayout Spacing="0">
					<pancakeView:PancakeView Margin="0,60,0,0"
											 CornerRadius="8"
											 HorizontalOptions="Center"
											 StyleClass="Shadow">

						<Image Aspect="Fill"
							   HeightRequest="160"
							   HorizontalOptions="Start"
							   Source="{Binding ImageUrl.Value, Mode=OneTime}"
							   WidthRequest="160" />
					</pancakeView:PancakeView>

					<Label Margin="0,40,0,0"
						   FontAttributes="Bold"
						   FontSize="Header"
						   HorizontalOptions="Center"
						   HorizontalTextAlignment="Center"
						   LineBreakMode="TailTruncation"
						   MaxLines="2"
						   Text="{Binding Title.Value, Mode=OneTime}" />

					<Label Margin="0,10,0,0"
						   FontSize="Small"
						   HorizontalOptions="Center"
						   HorizontalTextAlignment="Center"
						   LineBreakMode="TailTruncation"
						   StyleClass="Secondary"
						   Text="{Binding Author.Value, Mode=OneTime}" />

					<controls:RatingBar Margin="0,10,0,0"
										HorizontalOptions="Center"
										Rating="{Binding Book.Rating}" />
				</StackLayout>

				<StackLayout Margin="0,10"
							 Orientation="Horizontal">

					<Button Command="{Binding PlayCommand}"
							FontSize="Micro"
							HorizontalOptions="FillAndExpand"
							VerticalOptions="Center">

						<Button.ImageSource>
							<FontImageSource FontFamily="Material"
											 Glyph="{x:Static icons:IconFont.Headset}"
											 Color="{AppThemeBinding Light={StaticResource TextColor},
																	 Dark={StaticResource DarkTextColor}}" />
						</Button.ImageSource>
					</Button>

					<Button Command="{Binding DownloadCommand}"
							FontSize="Micro"
							HorizontalOptions="FillAndExpand"
							VerticalOptions="Center">

						<Button.ImageSource>
							<FontImageSource FontFamily="Material"
											 Glyph="{x:Static icons:IconFont.FileDownload}"
											 Color="{AppThemeBinding Light={StaticResource TextColor},
																	 Dark={StaticResource DarkTextColor}}" />
						</Button.ImageSource>
					</Button>
				</StackLayout>

				<BoxView StyleClass="Separator" />

				<Label FontAttributes="Bold"
					   Text="{Binding LocalizableProperties.Home.Book.Description.Value}" />

				<Label FontSize="Small"
					   LineBreakMode="WordWrap"
					   MaxLines="3"
					   Text="{Binding Description.Value}">

					<Label.Triggers>
						<DataTrigger Binding="{Binding DescriptionExpanded.Value}"
									 TargetType="{x:Type Label}"
									 Value="True">
							<Setter Property="MaxLines" Value="-1" />
						</DataTrigger>
					</Label.Triggers>
				</Label>

				<Button Command="{Binding ToggleDescriptionLengthCommand}"
						FontSize="Small"
						HorizontalOptions="End"
						Text="{Binding DescriptionToggleLabel.Value.Value}" />

				<Label FontAttributes="Bold"
					   Text="{Binding LocalizableProperties.Home.Book.Chapters.Value}" />

				<BoxView Margin="0,0,0,5"
						 StyleClass="Separator" />
			</StackLayout>
		</CollectionView.Header>

		<CollectionView.ItemTemplate>
			<DataTemplate x:DataType="chapters:ChapterViewModel">
				<StackLayout>
					<Grid Padding="0,5"
						  ColumnDefinitions="*,Auto,Auto"
						  ColumnSpacing="15">

						<Grid.GestureRecognizers>
							<TapGestureRecognizer Command="{Binding Media.TogglePlayCommand}" />
						</Grid.GestureRecognizers>

						<StackLayout Grid.Column="0"
									 VerticalOptions="End">

							<Label controlExtensions:StyleExtensions.Styles="Primary"
								   FontSize="Small"
								   LineBreakMode="TailTruncation"
								   Text="{Binding Title.Value, Mode=OneTime}"
								   VerticalOptions="Center">

								<Label.Triggers>
									<DataTrigger Binding="{Binding Media.IsPlaying.Value}"
												 TargetType="{x:Type Label}"
												 Value="True">
										<Setter Property="controlExtensions:StyleExtensions.Styles" Value="Accent" />
									</DataTrigger>
								</Label.Triggers>
							</Label>

							<StackLayout HorizontalOptions="StartAndExpand"
										 Orientation="Horizontal"
										 VerticalOptions="Center">

								<Label FontFamily="Material"
									   FontSize="Micro"
									   HorizontalOptions="End"
									   IsVisible="{Binding Download.IsDownloaded.Value}"
									   StyleClass="Accent"
									   Text="{x:Static icons:IconFont.FileDownload}"
									   VerticalOptions="Center" />

								<Label FontSize="Micro"
									   StyleClass="Secondary"
									   Text="{Binding Media.SizeLabel.Value}" />
							</StackLayout>
						</StackLayout>

						<Label Grid.Column="1"
							   controlExtensions:StyleExtensions.Styles="Secondary"
							   FontSize="Micro"
							   LineBreakMode="NoWrap"
							   Text="{Binding Media.Duration.Value, StringFormat='{}{0:mm\\:ss}', Mode=OneTime}"
							   VerticalOptions="Center">

							<Label.Triggers>
								<DataTrigger Binding="{Binding Media.IsPlaying.Value}"
											 TargetType="{x:Type Label}"
											 Value="True">
									<Setter Property="controlExtensions:StyleExtensions.Styles" Value="Accent" />
								</DataTrigger>
							</Label.Triggers>
						</Label>

						<Button Grid.Column="2"
								Command="{Binding Book.ShowDetailsCommand}"
								CommandParameter="{Binding}">
							<Button.ImageSource>
								<FontImageSource FontFamily="Material"
												 Glyph="{x:Static icons:IconFont.MoreHoriz}"
												 Color="{AppThemeBinding Light={StaticResource TextColor},
																		 Dark={StaticResource DarkTextColor}}" />
							</Button.ImageSource>
						</Button>
					</Grid>

					<BoxView StyleClass="Separator" />
				</StackLayout>
			</DataTemplate>
		</CollectionView.ItemTemplate>
	</CollectionView>
</ContentPage>