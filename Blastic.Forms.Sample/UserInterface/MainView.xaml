<?xml version="1.0" encoding="utf-8" ?>
<Shell x:Class="Blastic.Forms.Sample.UserInterface.MainView"
	   xmlns="http://xamarin.com/schemas/2014/forms"
	   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	   xmlns:controlExtensions="clr-namespace:Blastic.Forms.ControlExtensions;assembly=Blastic.Forms"
	   xmlns:d="http://xamarin.com/schemas/2014/forms/design"
	   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	   xmlns:tab="clr-namespace:Blastic.Forms.UserInterface;assembly=Blastic.Forms"
	   xmlns:userInterface="clr-namespace:Blastic.Forms.Sample.UserInterface;assembly=Blastic.Forms.Sample"
	   xmlns:viewManagement="clr-namespace:Blastic.Forms.ViewManagement;assembly=Blastic.Forms"
	   mc:Ignorable="d">

	<d:Shell.BindingContext>
		<userInterface:MainViewModel />
	</d:Shell.BindingContext>

	<Shell.Resources>
		<DataTemplate x:Key="TabTemplate"
					  x:DataType="tab:IShellTab">
			<Tab Title="{Binding Title.Value, Mode=OneWay}">
				<ShellContent viewManagement:View.Model="{Binding}" />
			</Tab>
		</DataTemplate>
	</Shell.Resources>

	<TabBar controlExtensions:TabbarExtensions.ShellTabs="{Binding Items}"
			controlExtensions:TabbarExtensions.TabTemplate="{StaticResource TabTemplate}"
			controlExtensions:TabbarExtensions.SelectedItem="{Binding ActiveItem.Value}"
			Title="{Binding ActiveItem.Value.Title.Value, Mode=OneWay}"/>
</Shell>