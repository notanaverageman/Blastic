<?xml version="1.0" encoding="utf-8" ?>
<MultiPage x:Class="Blastic.Forms.Sample.UserInterface.MainView"
		   xmlns="http://xamarin.com/schemas/2014/forms"
		   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
		   xmlns:controls="clr-namespace:Blastic.Forms.Sample.Controls;assembly=Blastic.Forms.Sample"
		   xmlns:converters="clr-namespace:Blastic.Forms.Converters;assembly=Blastic.Forms"
		   xmlns:d="http://xamarin.com/schemas/2014/forms/design"
		   xmlns:iOsSpecific="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
		   xmlns:icons="clr-namespace:Blastic.Forms.Sample.Icons;assembly=Blastic.Forms.Sample"
		   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		   xmlns:overlay="clr-namespace:Blastic.Forms.Sample.Controls.Overlay;assembly=Blastic.Forms.Sample"
		   xmlns:pancakeView="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
		   xmlns:tab="clr-namespace:Blastic.Forms.UserInterface;assembly=Blastic.Forms"
		   xmlns:userInterface="clr-namespace:Blastic.Forms.Sample.UserInterface;assembly=Blastic.Forms.Sample"
		   xmlns:viewManagement="clr-namespace:Blastic.Forms.ViewManagement;assembly=Blastic.Forms"
		   mc:Ignorable="d"
		   iOsSpecific:Page.UseSafeArea="True"
		   x:DataType="userInterface:MainViewModel"
		   x:TypeArguments="Page"
		   BackgroundColor="{DynamicResource Background}">

	<controls:ExtendedTabbedPage x:Name="TabbedPage"
								 ItemsSource="{Binding Items}">
		<controls:ExtendedTabbedPage.ItemTemplate>
			<DataTemplate x:DataType="tab:IShellTab">
				<ContentPage Title="{Binding Title.Value}"
							 BackgroundColor="{DynamicResource Background}"
							 IconImageSource="{Binding IconGlyph.Value, Converter={converters:ToolBarIconValueConverter}}">

					<ContentView viewManagement:View.Model="{Binding}" />
				</ContentPage>
			</DataTemplate>
		</controls:ExtendedTabbedPage.ItemTemplate>
	</controls:ExtendedTabbedPage>

	<controls:InputPassthroughPage BackgroundColor="Transparent">
		<overlay:OverlayView State="{Binding HomeViewModel.OverlayState.Value}"
							 TabBar="{Binding Source={x:Reference TabbedPage}}">
			<overlay:OverlayView.Collapsed>
				<Grid BackgroundColor="{StaticResource MainBarBackground}"
					  HeightRequest="57"
					  RowDefinitions="Auto,Auto,Auto"
					  RowSpacing="0">

					<Grid.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding HomeViewModel.ToggleOverlayStateCommand}"
											  CommandParameter="{x:Static overlay:OverlayState.Expanded}" />
					</Grid.GestureRecognizers>

					<ProgressBar Grid.Row="0"
								 HeightRequest="0.5"
								 Progress="0.5"
								 ProgressColor="{StaticResource BlasticWhiteColor}" />

					<Grid Grid.Row="1"
						  ColumnDefinitions="Auto,*,Auto">

						<Image Grid.Column="0"
							   Margin="0,0.5,0,0"
							   Source="{Binding HomeViewModel.SelectedBook.Value.ImageUrl.Value}"
							   VerticalOptions="End" />

						<StackLayout Grid.Column="1"
									 Margin="16,0"
									 VerticalOptions="Center">

							<Label FontSize="Micro"
								   LineBreakMode="TailTruncation"
								   Text="{Binding HomeViewModel.SelectedBook.Value.Title.Value}" />

							<Label FontSize="Micro"
								   Text="{Binding HomeViewModel.SelectedBook.Value.Creator.Value}"
								   TextColor="{StaticResource MainBarDisabledTextColor}" />
						</StackLayout>

						<ImageButton Grid.Column="2"
									 Margin="0,0,16,0"
									 VerticalOptions="Center">
							<ImageButton.Source>
								<FontImageSource FontFamily="{DynamicResource MaterialFontFamily}"
												 Glyph="{x:Static icons:IconFont.PlayCircleOutline}" />
							</ImageButton.Source>
						</ImageButton>
					</Grid>

					<BoxView Grid.Row="2"
							 HeightRequest="1"
							 HorizontalOptions="FillAndExpand" />
				</Grid>
			</overlay:OverlayView.Collapsed>
			<overlay:OverlayView.Expanded>
				<pancakeView:PancakeView CornerRadius="18,18,0,0">

					<pancakeView:PancakeView.Background>
						<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
							<GradientStop Offset="0" Color="{DynamicResource MainBarBackground}" />
							<GradientStop Offset="1" Color="{DynamicResource Background}" />
						</LinearGradientBrush>
					</pancakeView:PancakeView.Background>

					<Grid Margin="16,16,16,0"
						  RowDefinitions="Auto,*,Auto,Auto"
						  RowSpacing="0">

						<Grid Grid.Row="0"
							  ColumnDefinitions="Auto,*,Auto">

							<ImageButton Grid.Column="0"
										 Padding="10"
										 Command="{Binding HomeViewModel.ToggleOverlayStateCommand}"
										 CommandParameter="{x:Static overlay:OverlayState.Collapsed}"
										 HorizontalOptions="Start"
										 VerticalOptions="Center">
								<ImageButton.Source>
									<FontImageSource FontFamily="{DynamicResource MaterialFontFamily}"
													 Glyph="{x:Static icons:IconFont.ChevronDown}"
													 Size="32" />
								</ImageButton.Source>
							</ImageButton>

							<Label Grid.Column="1"
								   FontSize="Small"
								   HorizontalOptions="Center"
								   Text="{Binding HomeViewModel.SelectedBook.Value.Title.Value}"
								   VerticalOptions="Center" />

							<ImageButton Grid.Column="2"
										 Padding="10"
										 HorizontalOptions="End"
										 VerticalOptions="Center">
								<ImageButton.Source>
									<FontImageSource FontFamily="{DynamicResource MaterialFontFamily}"
													 Glyph="{x:Static icons:IconFont.DotsHorizontal}"
													 Size="32" />
								</ImageButton.Source>
							</ImageButton>
						</Grid>

						<StackLayout Grid.Row="1"
									 Margin="16,16,16,0">

							<Image Aspect="AspectFill"
								   HorizontalOptions="FillAndExpand"
								   Source="{Binding HomeViewModel.SelectedBook.Value.ImageUrl.Value}"
								   VerticalOptions="FillAndExpand" />

							<Label Margin="0,16,0,0"
								   FontSize="Large"
								   Text="{Binding HomeViewModel.SelectedBook.Value.Title.Value}" />

							<Label FontSize="Small"
								   Text="{Binding HomeViewModel.SelectedBook.Value.Creator.Value}"
								   TextColor="{StaticResource MainBarDisabledTextColor}" />
						</StackLayout>

						<StackLayout Grid.Row="2"
									 Margin="16,16,16,0"
									 Spacing="0">
							<Grid>
								<Label FontSize="Micro"
									   HorizontalOptions="Start"
									   Text="00:00" />

								<Label FontSize="Micro"
									   HorizontalOptions="End"
									   Text="03:42" />
							</Grid>

							<Slider MinimumTrackColor="{StaticResource BlasticWhiteColor}"
									Value="0.5">
								<Slider.ThumbImageSource>
									<FontImageSource FontFamily="{DynamicResource MaterialFontFamily}"
													 Glyph="{x:Static icons:IconFont.CircleMedium}"
													 Size="48" />
								</Slider.ThumbImageSource>
							</Slider>
						</StackLayout>

						<Grid Grid.Row="3"
							  Margin="16,0,16,64"
							  ColumnDefinitions="Auto,*,Auto">

							<ImageButton Grid.Column="0"
										 VerticalOptions="Center">
								<ImageButton.Source>
									<FontImageSource FontFamily="{DynamicResource MaterialFontFamily}"
													 Glyph="{x:Static icons:IconFont.Shuffle}"
													 Size="18" />
								</ImageButton.Source>
							</ImageButton>

							<StackLayout Grid.Column="1"
										 HorizontalOptions="Center"
										 Orientation="Horizontal">

								<ImageButton VerticalOptions="Center">
									<ImageButton.Source>
										<FontImageSource FontFamily="{DynamicResource MaterialFontFamily}"
														 Glyph="{x:Static icons:IconFont.SkipPrevious}"
														 Size="48" />
									</ImageButton.Source>
								</ImageButton>

								<ImageButton Margin="20"
											 VerticalOptions="Center">
									<ImageButton.Source>
										<FontImageSource FontFamily="{DynamicResource MaterialFontFamily}"
														 Glyph="{x:Static icons:IconFont.PlayCircle}"
														 Size="72" />
									</ImageButton.Source>
								</ImageButton>

								<ImageButton VerticalOptions="Center">
									<ImageButton.Source>
										<FontImageSource FontFamily="{DynamicResource MaterialFontFamily}"
														 Glyph="{x:Static icons:IconFont.SkipNext}"
														 Size="48" />
									</ImageButton.Source>
								</ImageButton>
							</StackLayout>

							<ImageButton Grid.Column="2"
										 VerticalOptions="Center">
								<ImageButton.Source>
									<FontImageSource FontFamily="{DynamicResource MaterialFontFamily}"
													 Glyph="{x:Static icons:IconFont.Repeat}"
													 Size="18" />
								</ImageButton.Source>
							</ImageButton>
						</Grid>
					</Grid>
				</pancakeView:PancakeView>
			</overlay:OverlayView.Expanded>
		</overlay:OverlayView>
	</controls:InputPassthroughPage>
</MultiPage>