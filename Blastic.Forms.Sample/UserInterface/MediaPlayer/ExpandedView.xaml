<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="Blastic.Forms.Sample.UserInterface.MediaPlayer.ExpandedView"
			 xmlns="http://xamarin.com/schemas/2014/forms"
			 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:d="http://xamarin.com/schemas/2014/forms/design"
			 xmlns:icons="clr-namespace:Blastic.Forms.Sample.Icons;assembly=Blastic.Forms.Sample"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:mediaPlayer="clr-namespace:Blastic.Forms.Sample.UserInterface.MediaPlayer;assembly=Blastic.Forms.Sample"
			 xmlns:overlay="clr-namespace:Blastic.Forms.Sample.Controls.Overlay;assembly=Blastic.Forms.Sample"
			 xmlns:pancakeView="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
			 mc:Ignorable="d"
			 x:DataType="mediaPlayer:MediaPlayerViewModel">

	<pancakeView:PancakeView Background="{AppThemeBinding Light={StaticResource OverlayBackground},
														  Dark={StaticResource DarkOverlayBackground}}"
							 CornerRadius="18,18,0,0">

		<Grid Margin="16,16,16,0"
			  RowDefinitions="Auto,*,Auto,Auto"
			  RowSpacing="0">

			<Grid Grid.Row="0"
				  ColumnDefinitions="Auto,*,Auto">

				<ImageButton Grid.Column="0"
							 Padding="10"
							 Command="{Binding ChangeOverlayStateCommand}"
							 CommandParameter="{x:Static overlay:OverlayState.Collapsed}"
							 HorizontalOptions="Start"
							 VerticalOptions="Center">
					<ImageButton.Source>
						<FontImageSource FontFamily="Material"
										 Glyph="{x:Static icons:IconFont.KeyboardArrowDown}"
										 Size="32"
										 Color="{AppThemeBinding Light={StaticResource TextColor},
																 Dark={StaticResource DarkTextColor}}" />
					</ImageButton.Source>
				</ImageButton>

				<Label Grid.Column="1"
					   FontSize="Small"
					   HorizontalOptions="Center"
					   Text="{Binding CurrentChapter.Value.Book.Title.Value}"
					   VerticalOptions="Center" />

				<ImageButton Grid.Column="2"
							 Padding="10"
							 HorizontalOptions="End"
							 VerticalOptions="Center">
					<ImageButton.Source>
						<FontImageSource FontFamily="Material"
										 Glyph="{x:Static icons:IconFont.MoreHoriz}"
										 Size="32"
										 Color="{AppThemeBinding Light={StaticResource TextColor},
																 Dark={StaticResource DarkTextColor}}" />
					</ImageButton.Source>
				</ImageButton>
			</Grid>

			<StackLayout Grid.Row="1"
						 Margin="16,16,16,0">

				<pancakeView:PancakeView CornerRadius="4"
										 HorizontalOptions="FillAndExpand"
										 VerticalOptions="FillAndExpand">
					<Image Aspect="Fill"
						   Source="{Binding CurrentChapter.Value.Book.ImageUrl.Value}" />

					<pancakeView:PancakeView.Shadow>
						<pancakeView:DropShadow />
					</pancakeView:PancakeView.Shadow>
				</pancakeView:PancakeView>

				<Label Margin="0,16,0,0"
					   FontSize="Large"
					   Text="{Binding CurrentChapter.Value.Title.Value}" />

				<Label FontSize="Small"
					   StyleClass="Secondary"
					   Text="{Binding CurrentChapter.Value.Book.Title.Value}" />
			</StackLayout>

			<StackLayout Grid.Row="2"
						 Margin="16,16,16,0"
						 Spacing="0">
				<Grid>
					<Label FontSize="Micro"
						   HorizontalOptions="Start"
						   Text="{Binding CurrentChapter.Value.Media.PlayedDurationLabel.Value}" />

					<Label FontSize="Micro"
						   HorizontalOptions="End"
						   Text="{Binding CurrentChapter.Value.Media.RemainingDurationLabel.Value}" />
				</Grid>

				<Slider DragCompletedCommand="{Binding CurrentChapter.Value.Media.SeekCompletedCommand}"
						DragStartedCommand="{Binding CurrentChapter.Value.Media.SeekStartedCommand}"
						MinimumTrackColor="{AppThemeBinding Light={StaticResource Accent},
															Dark={StaticResource DarkAccent}}"
						Value="{Binding CurrentChapter.Value.Media.PlayedPercent.Value, Mode=TwoWay}" />
			</StackLayout>

			<Grid Grid.Row="3"
				  Margin="16,20"
				  ColumnDefinitions="Auto,*,Auto,*,Auto">

				<ImageButton Grid.Column="0"
							 VerticalOptions="Center">
					<ImageButton.Source>
						<FontImageSource FontFamily="Material"
										 Glyph="{x:Static icons:IconFont.SkipPrevious}"
										 Size="36"
										 Color="{AppThemeBinding Light={StaticResource TextColor},
																 Dark={StaticResource DarkTextColor}}" />
					</ImageButton.Source>
				</ImageButton>

				<ImageButton Grid.Column="1"
							 Command="{Binding CurrentChapter.Value.Media.SkipBackwardCommand}"
							 VerticalOptions="Center">
					<ImageButton.Source>
						<FontImageSource FontFamily="Material"
										 Glyph="{x:Static icons:IconFont.Replay30}"
										 Size="36"
										 Color="{AppThemeBinding Light={StaticResource TextColor},
																 Dark={StaticResource DarkTextColor}}" />
					</ImageButton.Source>
				</ImageButton>

				<Button Grid.Column="2"
						Command="{Binding CurrentChapter.Value.Media.TogglePlayCommand}"
						CornerRadius="20"
						HeightRequest="{Binding Width, Source={RelativeSource Self}}"
						VerticalOptions="Center">

					<Button.ImageSource>
						<FontImageSource FontFamily="Material"
										 Glyph="{x:Static icons:IconFont.PlayCircleOutline}"
										 Size="72"
										 Color="{AppThemeBinding Light={StaticResource TextColor},
																 Dark={StaticResource DarkTextColor}}" />
					</Button.ImageSource>

					<Button.Triggers>
						<DataTrigger Binding="{Binding CurrentChapter.Value.Media.IsPlaying.Value}"
									 TargetType="Button"
									 Value="True">
							<Setter Property="ImageSource">
								<Setter.Value>
									<FontImageSource FontFamily="Material"
													 Glyph="{x:Static icons:IconFont.Pause}"
													 Size="72"
													 Color="{AppThemeBinding Light={StaticResource TextColor},
																			 Dark={StaticResource DarkTextColor}}" />
								</Setter.Value>
							</Setter>
						</DataTrigger>
					</Button.Triggers>
				</Button>

				<ImageButton Grid.Column="3"
							 Command="{Binding CurrentChapter.Value.Media.SkipForwardCommand}"
							 VerticalOptions="Center">
					<ImageButton.Source>
						<FontImageSource FontFamily="Material"
										 Glyph="{x:Static icons:IconFont.Forward30}"
										 Size="36"
										 Color="{AppThemeBinding Light={StaticResource TextColor},
																 Dark={StaticResource DarkTextColor}}" />
					</ImageButton.Source>
				</ImageButton>

				<ImageButton Grid.Column="4"
							 VerticalOptions="Center">
					<ImageButton.Source>
						<FontImageSource FontFamily="Material"
										 Glyph="{x:Static icons:IconFont.SkipNext}"
										 Size="36"
										 Color="{AppThemeBinding Light={StaticResource TextColor},
																 Dark={StaticResource DarkTextColor}}" />
					</ImageButton.Source>
				</ImageButton>
			</Grid>
		</Grid>
	</pancakeView:PancakeView>
</ContentView>