<ResourceDictionary x:Class="Blastic.Forms.Sample.Themes.ColorsLight"
                    xmlns="http://xamarin.com/schemas/2014/forms"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

	<Color x:Key="Accent">#FF9800</Color>
	<Color x:Key="Background">#FFFFFF</Color>
	<Color x:Key="SecondaryBackground">#F3F2F7</Color>
	<Color x:Key="TextColor">#000000</Color>
	<Color x:Key="SecondaryTextColor">#ACACAC</Color>
	<Color x:Key="SeparatorColor">#ACACAC</Color>
	<Color x:Key="RatingBarForegroundColor">#D1A700</Color>
	<Color x:Key="CancelColor">#C75364</Color>
	<LinearGradientBrush x:Key="OverlayBackground" StartPoint="0,0" EndPoint="0,1">
		<GradientStop Offset="0" Color="{StaticResource Background}" />
		<GradientStop Offset="1" Color="{StaticResource SecondaryBackground}" />
	</LinearGradientBrush>
</ResourceDictionary>