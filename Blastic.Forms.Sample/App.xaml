<?xml version="1.0" encoding="utf-8" ?>
<Application x:Class="Blastic.Forms.Sample.App"
			 xmlns="http://xamarin.com/schemas/2014/forms"
			 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:converters="clr-namespace:Blastic.Forms.Converters;assembly=Blastic.Forms"
			 xmlns:d="http://xamarin.com/schemas/2014/forms/design"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:theme="clr-namespace:Blastic.Forms.Themes;assembly=Blastic.Forms"
			 xmlns:userInterface="clr-namespace:Blastic.Forms.UserInterface;assembly=Blastic.Forms"
			 mc:Ignorable="d">

	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<theme:Blastic />
			</ResourceDictionary.MergedDictionaries>

			<OnPlatform x:Key="MaterialFontFamily"
						x:TypeArguments="x:String">
				<On Platform="iOS"
					Value="Material Design Icons" />
				<On Platform="Android"
					Value="materialdesignicons.ttf#Material Design Icons" />
			</OnPlatform>

			<Color x:Key="DarkBackground">#121212</Color>
			<Color x:Key="DarkMediaPlayerBackground">#282828</Color>
			<Color x:Key="DarkLightTextColor">#B3B3B3</Color>

			<Color x:Key="Background">#FFFFFF</Color>
			<Color x:Key="MediaPlayerCollapsedBackground">#F0DDDDDD</Color>
			<Color x:Key="MediaPlayerExpandedBackground">#FFDDDDDD</Color>
			<Color x:Key="DisabledTextColor">#999999</Color>
			<Color x:Key="LightTextColor">#ACACAC</Color>
			<Color x:Key="MediumTextColor">#777777</Color>

			<LinearGradientBrush x:Key="OverlayBackground">
				<GradientStop Offset="0" Color="{DynamicResource MediaPlayerExpandedBackground}" />
				<GradientStop Offset="1" Color="{DynamicResource Background}" />
			</LinearGradientBrush>

			<x:Double x:Key="BookImageHeight">120</x:Double>
			<x:Double x:Key="BookImageWidth">90</x:Double>

			<Style x:Key="PageStyle"
				   x:DataType="userInterface:IShellTab"
				   TargetType="{x:Type Page}">
				<Setter Property="Title" Value="{Binding Title.Value}" />
				<Setter Property="BackgroundColor" Value="{DynamicResource Background}" />
				<Setter Property="IconImageSource" Value="{Binding IconGlyph.Value, Converter={converters:ToolBarIconValueConverter}}" />
			</Style>
		</ResourceDictionary>
	</Application.Resources>
</Application>